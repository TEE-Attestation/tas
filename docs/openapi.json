{
  "openapi": "3.0.2",
  "info": {
    "title": "TEE Attestation Service API",
    "version": "0.1.0",
    "description": "A service for TEE (Trusted Execution Environment) attestation and key management",
    "contact": {
      "name": "HPE Security Lab",
      "url": "https://github.com/TEE-Attestation/tas",
      "email": "isaac.matthews@hpe.com"
    },
    "license": {
      "name": "MIT License",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5001",
      "description": "Development server"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-KEY",
        "description": "API key for authentication"
      },
      "ManagementApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-MANAGEMENT-API-KEY",
        "description": "Management API key for policy administration"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error message"
          }
        },
        "required": [
          "error"
        ]
      },
      "NonceResponse": {
        "type": "object",
        "properties": {
          "nonce": {
            "type": "string",
            "description": "Generated nonce for attestation",
            "example": "a1b2c3d4e5f6789abcdef0123456789abcdef0123456789abcdef0123456789"
          }
        },
        "required": [
          "nonce"
        ]
      },
      "SecretRequest": {
        "type": "object",
        "properties": {
          "tee-type": {
            "type": "string",
            "enum": [
              "amd-sev-snp",
              "intel-tdx"
            ],
            "description": "Type of TEE"
          },
          "nonce": {
            "type": "string",
            "description": "Previously obtained 64-character lowercase hexadecimal nonce. A single surrounding pair of double quotes (as sent by existing tas_agent releases) is removed before validation; the unquoted nonce is used for report-data binding."
          },
          "tee-evidence": {
            "type": "string",
            "description": "TEE attestation evidence (base64 encoded)"
          },
          "policy-id": {
            "type": "string",
            "description": "Policy identifier for attestation"
          },
          "report-data-binding": {
            "type": "boolean",
            "enum": [
              true
            ],
            "description": "The expected CPU report_data is always recomputed as SHA-512(nonce || wrapping_key || SHA-512(gpu0_evidence) || ...), binding the wrapping key and any GPU evidence to the CPU TEE. Required as the literal JSON Boolean true. False, missing, null, and non-Boolean values are rejected with HTTP 400. There is no operator opt-out; raw-nonce evidence is not accepted. Required GPU verification and policy claims are enforced independently."
          },
          "wrapping-key": {
            "type": "string",
            "description": "Base64-encoded PEM or DER RSA public key of at least 2048 bits. Validated before attestation verification; malformed, non-RSA, private, or undersized keys are rejected with HTTP 400. The original decoded bytes are used for binding and wrapping."
          },
          "component-evidence": {
            "$ref": "#/components/schemas/ComponentEvidence"
          }
        },
        "required": [
          "tee-type",
          "nonce",
          "tee-evidence",
          "policy-id",
          "report-data-binding",
          "wrapping-key"
        ]
      },
      "ComponentEvidence": {
        "type": "object",
        "description": "Optional attestation evidence for additional components (e.g. GPUs) keyed by component type. Evidence required by the selected policy is verified alongside the CPU TEE regardless of report-data binding.",
        "properties": {
          "gpu": {
            "type": "array",
            "description": "Per-GPU attestation evidence entries. At most `TAS_GPU_MAX_EVIDENCE_ENTRIES` entries (default 16) are accepted. The entries' `device-index` values must be unique and contiguous from 0 (i.e. cover 0..N-1), in any order.",
            "items": {
              "$ref": "#/components/schemas/GpuEvidence"
            }
          }
        }
      },
      "GpuEvidence": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "GPU device type. Must be a supported value; it selects which `components.gpu` policy rules are applied to this device. Entries with any other value are rejected.",
            "enum": [
              "gpu-nvidia"
            ],
            "example": "gpu-nvidia"
          },
          "evidence": {
            "type": "string",
            "description": "Base64-encoded GPU attestation evidence envelope"
          },
          "device-index": {
            "type": "integer",
            "minimum": 0,
            "description": "Non-negative GPU device index. Across the list the indices must be unique and contiguous from 0 (used for deterministic ordering of the report_data binding)",
            "example": 0
          }
        },
        "required": [
          "type",
          "evidence",
          "device-index"
        ]
      },
      "SecretResponse": {
        "type": "object",
        "properties": {
          "secret_key": {
            "type": "string",
            "description": "Retrieved and wrapped secret key"
          }
        },
        "required": [
          "secret_key"
        ]
      },
      "PolicyMetadata": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Policy name"
          },
          "policy_id": {
            "type": "string",
            "description": "Unique identifier for the policy"
          },
          "policy_type": {
            "type": "string",
            "description": "TEE type (e.g. SEV, TDX)",
            "example": "SEV"
          },
          "key_id": {
            "type": "string",
            "description": "Identifier of the key to retrieve after successful attestation against policy"
          },
          "version": {
            "type": "string",
            "description": "Policy version"
          },
          "description": {
            "type": "string",
            "description": "Policy description"
          },
          "created_by": {
            "type": "string",
            "description": "Policy creator"
          },
          "created_date": {
            "type": "string",
            "description": "Creation date"
          },
          "last_updated": {
            "type": "string",
            "description": "Last update date"
          }
        },
        "required": [
          "name",
          "version",
          "policy_type",
          "policy_id",
          "key_id"
        ]
      },
      "PolicyValidationRules": {
        "type": "object",
        "properties": {
          "measurement": {
            "type": "object",
            "properties": {
              "exact_match": {
                "type": "string",
                "description": "Expected measurement value"
              }
            }
          },
          "version": {
            "type": "object",
            "properties": {
              "min_value": {
                "type": "integer",
                "description": "Minimum required version"
              }
            }
          },
          "vmpl": {
            "type": "object",
            "properties": {
              "exact_match": {
                "type": "integer",
                "description": "Expected VMPL level"
              }
            }
          },
          "debug": {
            "type": "boolean",
            "description": "Debug flag validation"
          }
        },
        "description": "Validation rules for TEE attestation"
      },
      "PolicySignature": {
        "type": "object",
        "properties": {
          "algorithm": {
            "type": "string",
            "description": "Signature algorithm",
            "example": "SHA384"
          },
          "padding": {
            "type": "string",
            "description": "Padding scheme",
            "example": "PSS"
          },
          "value": {
            "type": "string",
            "description": "Base64-encoded signature"
          }
        },
        "required": [
          "algorithm",
          "padding",
          "value"
        ]
      },
      "PolicyData": {
        "type": "object",
        "properties": {
          "metadata": {
            "$ref": "#/components/schemas/PolicyMetadata"
          },
          "validation_rules": {
            "$ref": "#/components/schemas/PolicyValidationRules"
          },
          "components": {
            "$ref": "#/components/schemas/PolicyComponents"
          },
          "signature": {
            "$ref": "#/components/schemas/PolicySignature"
          }
        },
        "required": [
          "metadata",
          "validation_rules"
        ]
      },
      "PolicyComponents": {
        "type": "object",
        "description": "Optional policies for additional attestable components verified alongside the CPU TEE. Keyed by component type (e.g. gpu).",
        "properties": {
          "gpu": {
            "type": "object",
            "description": "GPU component policy, keyed by GPU device type (e.g. gpu-nvidia). Each value is an NVIDIA attestation policy (with version and authorization-rules) validated by nvidia_pytools against NRAS claims.",
            "additionalProperties": {
              "type": "object"
            }
          }
        },
        "additionalProperties": true
      },
      "VersionResponse": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "description": "TAS version",
            "example": "0.1.0"
          }
        },
        "required": [
          "version"
        ]
      },
      "AttestRequest": {
        "type": "object",
        "properties": {
          "nonce": {
            "type": "string",
            "description": "Caller-chosen random nonce, 16-64 bytes as hexadecimal",
            "example": "3f0c6a1e9b2d4c7a8e5f1b0d2c4a6e8f1a3b5c7d9e0f2a4b6c8d0e1f3a5b7c9d"
          }
        },
        "required": [
          "nonce"
        ]
      },
      "AttestResponse": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "description": "Kernel TSM provider that produced the report",
            "enum": [
              "sev_guest",
              "tdx_guest"
            ]
          },
          "nonce": {
            "type": "string",
            "description": "The nonce from the request, echoed"
          },
          "tls_cert_sha256": {
            "type": "string",
            "description": "SHA-256 (hex) of the DER TLS leaf certificate bound into REPORT_DATA; must match the certificate the caller observed in its own TLS handshake"
          },
          "report": {
            "type": "string",
            "format": "byte",
            "description": "Base64 raw report (SEV-SNP ATTESTATION_REPORT, 1184 bytes; TDX quote)"
          },
          "auxblob": {
            "type": "string",
            "format": "byte",
            "nullable": true,
            "description": "Base64 raw auxiliary blob when the provider supplies one (SEV-SNP GHCB certificate table), else null"
          }
        },
        "required": [
          "provider",
          "nonce",
          "tls_cert_sha256",
          "report"
        ]
      },
      "StatusResponse": {
        "type": "object",
        "description": "Redis persistence and policy storage status. redis_persistence_active and config_rewrite_succeeded report Redis-only persistence state. policy_storage reports the active policy storage backend and reachability.",
        "properties": {
          "redis_persistence_active": {
            "description": "Redis-only indicator of whether AOF + RDB persistence is currently active. \"unknown\" if Redis could not be queried.",
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": [
                  "unknown"
                ]
              }
            ],
            "example": true
          },
          "config_rewrite_succeeded": {
            "description": "Redis-only indicator of whether CONFIG REWRITE succeeded at startup. true = settings persisted to redis.conf, false = REWRITE failed (settings active but not persisted), null = persistence not attempted (TAS_REDIS_PERSISTENCE=false).",
            "type": "boolean",
            "nullable": true,
            "example": true
          },
          "policy_storage": {
            "type": "object",
            "description": "Active policy storage backend status.",
            "properties": {
              "backend": {
                "type": "string",
                "enum": [
                  "redis",
                  "postgresql"
                ],
                "example": "redis"
              },
              "reachable": {
                "type": "boolean",
                "example": true
              }
            },
            "required": [
              "backend",
              "reachable"
            ]
          }
        },
        "required": [
          "redis_persistence_active",
          "config_rewrite_succeeded",
          "policy_storage"
        ]
      }
    },
    "headers": {
      "Deprecation": {
        "description": "Indicates the endpoint is deprecated (RFC 8594)",
        "schema": {
          "type": "string",
          "example": "true"
        }
      },
      "Sunset": {
        "description": "Date after which the endpoint will be removed (RFC 8594, RFC 7231 IMF-fixdate)",
        "schema": {
          "type": "string",
          "example": "Tue, 31 Mar 2026 23:59:59 GMT"
        }
      },
      "Link": {
        "description": "Link to the replacement endpoint",
        "schema": {
          "type": "string"
        }
      },
      "Warning": {
        "description": "Human-readable deprecation warning",
        "schema": {
          "type": "string"
        }
      }
    }
  },
  "paths": {
    "/kb/v0/get_nonce": {
      "get": {
        "tags": [
          "Key Broker"
        ],
        "summary": "Generate nonce for attestation",
        "description": "Generates a cryptographic nonce for use in TEE attestation",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Nonce generated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NonceResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/kb/v0/get_secret": {
      "post": {
        "tags": [
          "Key Broker"
        ],
        "summary": "Get secret key after TEE verification",
        "description": "Validates TEE evidence and returns the requested secret key",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SecretRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Secret retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SecretResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - Invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid nonce or API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Key not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/version": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Get TAS version",
        "description": "Returns the current version of the TEE Attestation Service",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Version information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/management/policy/v0/store": {
      "post": {
        "tags": [
          "Policy Management"
        ],
        "summary": "Store a security policy",
        "description": "Stores a security policy for later use in attestation validation",
        "security": [
          {
            "ManagementApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PolicyData"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Policy stored successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "warning": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - Invalid policy data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid management API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/management/policy/v0/get/{policy_id}": {
      "get": {
        "tags": [
          "Policy Management"
        ],
        "summary": "Get a security policy",
        "description": "Retrieves a stored security policy by its policy_id",
        "security": [
          {
            "ManagementApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "policy_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Policy identifier"
          }
        ],
        "responses": {
          "200": {
            "description": "Policy retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "policy_key": {
                      "type": "string",
                      "description": "Redis storage key"
                    },
                    "policy": {
                      "$ref": "#/components/schemas/PolicyData"
                    },
                    "warning": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Policy not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/management/policy/v0/list": {
      "get": {
        "tags": [
          "Policy Management"
        ],
        "summary": "List all policies",
        "description": "Lists all stored security policies",
        "security": [
          {
            "ManagementApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Policies listed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "policies": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "policy_id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "policy_type": {
                            "type": "string"
                          },
                          "key_id": {
                            "type": "string"
                          },
                          "version": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "signed": {
                            "type": "boolean"
                          }
                        }
                      }
                    },
                    "count": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/management/policy/v0/delete/{policy_id}": {
      "delete": {
        "tags": [
          "Policy Management"
        ],
        "summary": "Delete a security policy",
        "description": "Deletes a stored security policy",
        "security": [
          {
            "ManagementApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "policy_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Policy identifier to delete"
          }
        ],
        "responses": {
          "200": {
            "description": "Policy deleted successfully"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Policy not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/management/status": {
      "get": {
        "tags": [
          "Management"
        ],
        "summary": "Get Redis persistence and policy storage status",
        "description": "Returns Redis persistence state, whether CONFIG REWRITE succeeded at TAS startup, and the active policy storage backend and its reachability. Requires management API key.",
        "security": [
          {
            "ManagementApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Redis persistence and policy storage status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized \u2014 invalid or missing management API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/attest/v0/report": {
      "post": {
        "tags": [
          "Management"
        ],
        "summary": "TAS-attestation report of the CVM running TAS",
        "description": "Returns the raw attestation report (AMD SEV-SNP attestation report or Intel TDX quote) of the confidential VM that TAS itself runs in, so an operator can verify TAS before trusting it with secrets. The report is bound to the caller's nonce and to TAS's TLS certificate: REPORT_DATA = SHA-512(\"TAS-attest/v1\" || nonce || SHA-256(TLS leaf certificate DER)). Nothing is parsed server-side; verification (signature chain, REPORT_DATA, measurement, policy) is the caller's job, e.g. with `sev-verify-tas` from sev_pytools. Unauthenticated unless TAS_ATTEST_REQUIRE_MANAGEMENT_API_KEY is enabled. Subject to a global budget (TAS_ATTEST_RATE_LIMIT, default 2 per minute) because report generation is an expensive, serialised firmware request.",
        "security": [
          {},
          {
            "ManagementApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AttestRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Attestation report generated",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttestResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid nonce",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Management API key required (TAS_ATTEST_REQUIRE_MANAGEMENT_API_KEY=true) and missing or invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Report budget exhausted; retry after the number of seconds in Retry-After",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "501": {
            "description": "TAS is not running in a confidential VM (no configfs-tsm report slot)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Report temporarily unavailable \u2014 another report is being generated (retry after Retry-After seconds) or the TLS certificate needed for binding cannot be read",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/alphav1/nonce": {
      "get": {
        "tags": [
          "Certificate"
        ],
        "summary": "Generate a single-use nonce for attestation binding",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Nonce successfully generated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "nonce": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/alphav1/certify": {
      "post": {
        "tags": [
          "Certificate"
        ],
        "summary": "Issue or renew an X.509 certificate based on verified TEE attestation",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "tee-type",
                  "nonce",
                  "tee-evidence",
                  "csr",
                  "domain-policy"
                ],
                "properties": {
                  "tee-type": {
                    "type": "string"
                  },
                  "nonce": {
                    "type": "string",
                    "description": "Previously obtained 64-character lowercase hexadecimal nonce. A single surrounding pair of double quotes (as sent by existing tas_agent releases) is removed before validation; the unquoted nonce is used for report-data binding."
                  },
                  "tee-evidence": {
                    "type": "string",
                    "format": "base64"
                  },
                  "csr": {
                    "type": "string",
                    "format": "base64"
                  },
                  "domain-policy": {
                    "type": "string"
                  },
                  "gpu-evidence": {
                    "type": "array"
                  },
                  "renew_cert": {
                    "type": "string",
                    "description": "PEM-encoded prior certificate for renewal. When provided, the response certificate will reuse the prior SPIFFE UUID if validation succeeds"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Certificate successfully issued",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "certificate": {
                      "type": "string"
                    },
                    "ca_chain": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "description": "Issues a new certificate or renews an existing one by reusing its SPIFFE UUID, provided fresh attestation is verified"
      }
    }
  }
}
